# Copy to .env for local development and replace the secret placeholder.
# This file contains no real credentials. Do not put real keys here.
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LOCAL_SECRET
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is the simplest local setup. Its database is not included in Git.
DB_ENGINE=sqlite

# Required only when using the real AI features.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AGENT_MAX_STEPS=5
AGENT_MEMORY_MESSAGES=16

# Optional MySQL settings; used only with DB_ENGINE=mysql.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional email and weather integrations.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SENIVERSE_API_KEY=
SENIVERSE_PUBLIC_KEY=
SENIVERSE_PRIVATE_KEY=
